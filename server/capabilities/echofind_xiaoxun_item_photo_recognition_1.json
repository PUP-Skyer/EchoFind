{
  "id": "echofind_xiaoxun_item_photo_recognition_1",
  "pluginKey": "@official-plugins/ai-image-understanding",
  "pluginVersion": "1.0.22",
  "name": "EchoFind小寻AI助手物品拍照识别",
  "description": "用于EchoFind中控台「小寻」AI助手的拍照识别物品功能，识别用户上传图片中的物品名称和类别，用于关联物品库。",
  "icon": "",
  "paramsSchema": {
    "type": "object",
    "properties": {
      "item_photo": {
        "type": "array",
        "format": "plugin-image-url",
        "description": "用户上传的待识别物品照片",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "item_photo"
    ]
  },
  "formValue": {
    "images": "{{input.item_photo}}",
    "modelID": "2015",
    "modelParams": {
      "maxTokens": 8192,
      "temperature": 0.5
    },
    "prompt": "你是EchoFind系统的物品识别专家，擅长精准识别图片中的各类物品信息。请识别提供的物品照片，输出以下内容：1. 物品的标准名称（尽可能通用准确）；2. 物品所属的大类和细分类别；3. 物品的主要特征描述。输出要求：信息准确客观，分类清晰，便于与物品库进行匹配关联。"
  },
  "createdAt": 1790939104709,
  "updatedAt": 1790939104709,
  "createdBy": 7687860656644559167
}